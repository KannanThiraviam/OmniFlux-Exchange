# Host port mappings. Defaults avoid the card-fraud-* and nseml stacks.
OMNIFLUX_POSTGRES_PORT=5435
OMNIFLUX_S3_PORT=9005
OMNIFLUX_SEAWEEDFS_MASTER_PORT=9006
OMNIFLUX_POSTGREST_PORT=3001
OMNIFLUX_APP_PORT=8080
OMNIFLUX_POSTGREST_ADMIN_PORT=3002
# Browser-facing endpoint embedded in download presigned URLs.
OMNIFLUX_STORAGE_PUBLIC_ENDPOINT=http://localhost:9005
# Export source used by the worker: rest or r2dbc.
OMNIFLUX_SOURCE_DEFAULT_ADAPTER=rest
#
# ---------------------------------------------------------------------------
# Local stack credentials. These are local throwaways, not production
# secrets — production reads COS_* / DATA_API_* from the platform env.
# ---------------------------------------------------------------------------
# PostgreSQL + the local S3 service + the app's database/storage clients share these.
OMNIFLUX_DB_PASSWORD=omniflux-local-db
OMNIFLUX_S3_ACCESS_KEY=omniflux
OMNIFLUX_S3_SECRET_KEY=omniflux-local-s3-password
# PostgREST accepts the app's bearer token when it is a JWT (HS256) signed
# with this secret carrying at least {"role":"omniflux"}. Generate a matching
# pair:
# scripts/up.ps1 generates a random secret and matching token automatically.
# PUBLIC LOCAL-ONLY EXAMPLE: these values are committed and must never be
# reused in production, shared environments, or any deployed service.
OMNIFLUX_PGRST_JWT_SECRET=omniflux-local-jwt-secret-32-characters-minimum
OMNIFLUX_DATA_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoib21uaWZsdXgifQ.rTUxGAanoTtbFvd8l6JY-8kDwbghcs8EEcEZt8q8iGM
