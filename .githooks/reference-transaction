#!/bin/sh
# Blocks agents from updating trunk refs without explicit approval. Feature
# branch creation and updates are allowed so changes can be reviewed in PRs.
state="$1"
[ "$state" = "prepared" ] || exit 0

is_agent_context() {
  [ "${OFX_GIT_AGENT_CONTEXT:-}" = "1" ] && return 0
  [ -n "${CODEX_THREAD_ID:-}" ] && return 0
  [ -n "${CODEX_CI:-}" ] && return 0
  [ -n "${CODEX_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDE_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDECODE:-}" ] && return 0
  return 1
}

is_agent_context || exit 0
zero="0000000000000000000000000000000000000000"

while read old_sha new_sha ref_name; do
  case "$ref_name" in
    refs/heads/main|refs/heads/master)
      if [ "$new_sha" != "$old_sha" ] && [ "${OFX_ALLOW_GIT_REF_UPDATE:-}" != "1" ]; then
        echo "BLOCKED: agent trunk ref updates are disabled in this checkout." >&2
        echo "Agents need OFX_ALLOW_GIT_COMMIT=1 and OFX_ALLOW_GIT_REF_UPDATE=1 for an approved commit." >&2
        exit 1
      fi
      ;;
  esac
done
