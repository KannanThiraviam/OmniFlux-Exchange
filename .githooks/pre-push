#!/bin/sh
# Agent approval boundary and the full quality gate for the pushed checkout.
set -eu

is_agent_context() {
  [ "${OFX_GIT_AGENT_CONTEXT:-}" = "1" ] && return 0
  [ -n "${CODEX_THREAD_ID:-}" ] && return 0
  [ -n "${CODEX_CI:-}" ] && return 0
  [ -n "${CODEX_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDE_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDECODE:-}" ] && return 0
  return 1
}

if is_agent_context; then
  if [ "${OFX_ALLOW_GIT_PUSH:-}" != "1" ]; then
    echo "BLOCKED: agent git push is disabled in this checkout." >&2
    echo "Manual operator pushes are allowed; agents need OFX_ALLOW_GIT_PUSH=1." >&2
    exit 1
  fi
fi

# Maven tests the current checkout. Reject pushing a different revision rather
# than reporting results for code that is not being sent to the remote.
head=$(git rev-parse HEAD)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  commit=$(git rev-parse "$local_sha^{commit}")
  if [ "$commit" != "$head" ]; then
    echo "Quality gate requires the pushed revision to match HEAD. Check out that revision and push it separately." >&2
    exit 1
  fi
done
if ! command -v pwsh >/dev/null 2>&1; then
  echo "PowerShell 7 (pwsh) is required for the quality gate. See docs/QUALITY_GATES.md." >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel)
exec pwsh -NoProfile -File "$root/scripts/quality-gate.ps1" -ForPush
