#!/bin/sh
# Agent approval boundary and the full staged quality gate.
set -eu

is_agent_context() {
  [ "${OFX_GIT_AGENT_CONTEXT:-}" = "1" ] && return 0
  [ -n "${CODEX_THREAD_ID:-}" ] && return 0
  [ -n "${CODEX_CI:-}" ] && return 0
  [ -n "${CODEX_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDE_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDECODE:-}" ] && return 0
  return 1
}

if is_agent_context; then
  if [ "${OFX_ALLOW_GIT_COMMIT:-}" != "1" ]; then
    echo "BLOCKED: agent git commit is disabled in this checkout." >&2
    echo "Manual operator commits are allowed; agents need OFX_ALLOW_GIT_COMMIT=1." >&2
    exit 1
  fi
fi

git diff --cached --check
if ! command -v pwsh >/dev/null 2>&1; then
  echo "PowerShell 7 (pwsh) is required for the quality gate. See docs/QUALITY_GATES.md." >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel)
exec pwsh -NoProfile -File "$root/scripts/quality-gate.ps1" -Staged
