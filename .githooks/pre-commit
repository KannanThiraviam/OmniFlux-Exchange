#!/bin/sh
# Agent safety boundary + staged whitespace check. Humans commit freely;
# agents need explicit commit approval.
set -eu

is_agent_context() {
  [ "${OFX_GIT_AGENT_CONTEXT:-}" = "1" ] && return 0
  [ -n "${CODEX_THREAD_ID:-}" ] && return 0
  [ -n "${CODEX_CI:-}" ] && return 0
  [ -n "${CODEX_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDE_PROJECT_DIR:-}" ] && return 0
  [ -n "${CLAUDECODE:-}" ] && return 0
  return 1
}

if is_agent_context; then
  if [ "${OFX_ALLOW_GIT_COMMIT:-}" != "1" ]; then
    echo "BLOCKED: agent git commit is disabled in this checkout." >&2
    echo "Manual operator commits are allowed; agents need OFX_ALLOW_GIT_COMMIT=1." >&2
    exit 1
  fi
fi

# Keep the local hook fast and portable. Full Maven/Testcontainers verification
# runs in GitHub Actions on every PR; this catches whitespace errors locally.
git diff --cached --check
